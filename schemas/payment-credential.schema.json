{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifinpay.io/schemas/x405/payment-credential.schema.json",
  "title": "x405 Payment Credential",
  "type": "object",
  "additionalProperties": false,
  "required": ["credential_id", "profile_id", "provider_id", "type", "state", "allowed_rails", "token_reference", "created_at"],
  "properties": {
    "credential_id": { "type": "string", "pattern": "^cred_[A-Za-z0-9_-]+$" },
    "profile_id": { "type": "string", "pattern": "^afp_[A-Za-z0-9_-]+$" },
    "provider_id": { "type": "string" },
    "type": { "enum": ["CARD_TOKEN", "BANK_ACCOUNT_TOKEN", "CRYPTO_WALLET", "STABLECOIN_ACCOUNT", "X402_WALLET", "LOCAL_RAIL_TOKEN"] },
    "state": { "enum": ["PROVISIONING", "ACTIVE", "SUSPENDED", "REVOKED", "EXPIRED"] },
    "allowed_rails": {
      "type": "array",
      "items": { "enum": ["X402", "CARD", "BANK", "STABLECOIN", "CRYPTO", "LOCAL"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "currency_or_assets": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "token_reference": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  }
}
